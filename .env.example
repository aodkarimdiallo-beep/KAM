# ─────────────────────────────────────────────────────────────────────────────
# DIGITAL TWIN — variables d'environnement
#
# 1. Copiez ce fichier :   cp .env.example .env.local
# 2. Renseignez les valeurs (ne commitez JAMAIS .env.local, il est ignoré par git).
# 3. En production, saisissez les mêmes variables dans Vercel → Project → Settings
#    → Environment Variables.
#
# Règle : seules les variables préfixées NEXT_PUBLIC_ sont visibles du navigateur.
# Elles ne doivent contenir AUCUN secret.
# ─────────────────────────────────────────────────────────────────────────────

# URL publique de l'application (ex. http://localhost:3000 en local)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────────────
# Supabase → Project Settings → API (ou « API Keys »)
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique « publishable » (sb_publishable_…). L'ancienne clé « anon » fonctionne aussi.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé SECRÈTE (sb_secret_… ou ancienne « service_role »). Serveur uniquement :
# elle contourne la Row Level Security. Ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ── Intelligence artificielle ────────────────────────────────────────────────
# Fournisseur utilisé par défaut : gemini | openai | anthropic
AI_DEFAULT_PROVIDER=gemini

# Google AI Studio → Get API key (https://aistudio.google.com)
GEMINI_API_KEY=
# Modèle de conversation (identifiant exact, ex. visible dans Google AI Studio)
GEMINI_CHAT_MODEL=
# Modèle d'embeddings (étape 5)
GEMINI_EMBEDDING_MODEL=

# Fournisseurs additionnels (optionnels). OpenAI fonctionne déjà via AI_DEFAULT_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
ANTHROPIC_API_KEY=

# Optionnel : adresse alternative du fournisseur (passerelle d'entreprise, serveur de test local)
AI_BASE_URL=

# ── Coûts et limites ─────────────────────────────────────────────────────────
# Tarifs du modèle (USD par million de jetons), copiés depuis la page de prix officielle.
# Vides = coût enregistré à 0 (non estimé) plutôt qu'un chiffre inventé.
AI_PRICE_INPUT_USD_PER_MTOK=
AI_PRICE_OUTPUT_USD_PER_MTOK=
# Nombre maximum de messages par minute et par utilisateur (défaut : 10)
CHAT_MAX_REQUESTS_PER_MINUTE=

# ── Recherche Internet (étape 6, optionnel) ──────────────────────────────────
SEARCH_PROVIDER=
SEARCH_API_KEY=
